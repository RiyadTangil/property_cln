generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = "file:./dev.db"
}

model User {
  id           Int        @id @default(autoincrement())
  email        String     @unique
  username     String     @unique
  password     String
  name         String
  role         String     @default("Administrator")
  roleId       Int?
  roleRel      Role?      @relation(fields: [roleId], references: [id], onDelete: SetNull)
  jobTitle     String?
  phone        String?
  isSuperAdmin Boolean    @default(true)
  isActive     Boolean    @default(true)
  theme        String     @default("light")
  navLayout    String     @default("side")
  sidebarColor String     @default("light")
  timezone     String     @default("Asia/Dhaka")
  dateFormat   String     @default("d M Y")
  timeFormat   String     @default("g:i A")
  createdAt    DateTime   @default(now())
  auditLogs    AuditLog[]
}

model Company {
  id                 Int            @id @default(autoincrement())
  code               String         @default("HQ")
  name               String
  legalName          String?
  incorporationDate  String?
  registrationNumber String?
  tin                String?
  email              String?
  phone              String?
  website            String?
  addressLine1       String?
  addressLine2       String?
  city               String?
  state              String?
  postalCode         String?
  country            String         @default("Bangladesh")
  currency           String         @default("BDT")
  timezone           String         @default("Asia/Dhaka")
  fyStartMonth       Int            @default(7)
  fyStartDay         Int            @default(1)
  branch             String         @default("HQ")
  fiscalYear         String         @default("1 Jul – 30 Jun")
  isDefault          Boolean        @default(false)
  isActive           Boolean        @default(true)
  createdAt          DateTime       @default(now())
  branches           Branch[]
  departments        Department[]
  fiscalYears        FiscalYear[]
  holidays           Holiday[]
  shifts             Shift[]
  codeSequences      CodeSequence[]
  mfsServices        MfsService[]
  projects           Project[]
  landParcels        LandParcel[]
  chartAccounts      ChartAccount[]
  accountHeads       AccountHead[]
  bankAccounts       BankAccount[]
  lenders            Lender[]
  unitsOfMeasure     UnitOfMeasure[]
  productCategories  ProductCategory[]
  warehouses         Warehouse[]
  products           Product[]
  projectTypes       ProjectType[]
  projectCategories  ProjectCategory[]
  buildings          Building[]
  wbsTemplates       WbsTemplate[]
  cbsTemplates       CbsTemplate[]
  estimateTemplates  EstimateTemplate[]
  taskTemplates      TaskTemplate[]
  projectParameters  ProjectParameter[]
  itpTemplates       ItpTemplate[]
  costBreakdownItems CostBreakdownItem[]
  inspectionChecklists InspectionChecklist[]
}

model Branch {
  id           Int          @id @default(autoincrement())
  code         String       @unique
  name         String
  type         String       @default("branch")
  companyId    Int          @default(1)
  company      Company      @relation(fields: [companyId], references: [id], onDelete: Cascade)
  openedOn     String?
  phone        String?
  email        String?
  managerName  String?
  addressLine1 String?
  addressLine2 String?
  city         String?
  state        String?
  postalCode   String?
  country      String       @default("Bangladesh")
  isActive     Boolean      @default(true)
  createdAt    DateTime     @default(now())
  departments  Department[]
  warehouses   Warehouse[]
}

model Department {
  id           Int           @id @default(autoincrement())
  code         String        @unique
  name         String
  companyId    Int           @default(1)
  company      Company       @relation(fields: [companyId], references: [id], onDelete: Cascade)
  branchId     Int?
  branch       Branch?       @relation(fields: [branchId], references: [id], onDelete: SetNull)
  parentId     Int?
  parent       Department?   @relation("DeptHierarchy", fields: [parentId], references: [id], onDelete: SetNull)
  children     Department[]  @relation("DeptHierarchy")
  headName     String?
  email        String?
  phone        String?
  description  String?
  isActive     Boolean       @default(true)
  createdAt    DateTime      @default(now())
  designations Designation[]
}

model Designation {
  id             Int         @id @default(autoincrement())
  code           String
  name           String
  departmentId   Int?
  department     Department? @relation(fields: [departmentId], references: [id], onDelete: SetNull)
  employmentType String      @default("full_time")
  grade          String?
  description    String?
  isManagerial   Boolean     @default(false)
  isActive       Boolean     @default(true)
  createdBy      String?
  createdAt      DateTime    @default(now())
}

model FiscalYear {
  id                  Int      @id @default(autoincrement())
  companyId           Int      @default(1)
  company             Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  code                String   @unique
  name                String
  startDate           String
  endDate             String
  periodCadence       String   @default("monthly")
  hasAdjustmentPeriod Boolean  @default(false)
  isCurrent           Boolean  @default(false)
  status              String   @default("open")
  notes               String?
  createdAt           DateTime @default(now())
}

model Holiday {
  id          Int      @id @default(autoincrement())
  companyId   Int      @default(1)
  company     Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  name        String
  type        String   @default("public")
  startDate   String
  endDate     String
  color       String   @default("#00c292")
  description String?
  appliesTo   String   @default("all")
  isRecurring Boolean  @default(false)
  isPaid      Boolean  @default(true)
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
}

model Shift {
  id              Int      @id @default(autoincrement())
  companyId       Int      @default(1)
  company         Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  code            String   @unique
  name            String
  startTime       String   @default("09:00")
  endTime         String   @default("18:00")
  breakMinutes    Int      @default(60)
  graceInMinutes  Int      @default(15)
  graceOutMinutes Int      @default(15)
  fullDayMinutes  Int      @default(480)
  halfDayMinutes  Int      @default(240)
  workingDays     String   @default("mon,tue,wed,thu,sun")
  appliesTo       String   @default("all")
  description     String?
  isDefault       Boolean  @default(false)
  isActive        Boolean  @default(true)
  createdAt       DateTime @default(now())
}

model Role {
  id               Int      @id @default(autoincrement())
  name             String   @unique
  scope            String   @default("global")
  isSuper          Boolean  @default(false)
  permissionsCount Int      @default(0)
  permissionsJson  String   @default("[]")
  createdAt        DateTime @default(now())
  users            User[]
}

model CodeSequence {
  id          Int     @id @default(autoincrement())
  companyId   Int     @default(1)
  company     Company @relation(fields: [companyId], references: [id], onDelete: Cascade)
  key         String  @unique
  label       String
  prefix      String
  suffix      String  @default("")
  separator   String  @default("-")
  padding     Int     @default(4)
  nextNumber  Int     @default(1)
  yearInCode  Boolean @default(false)
  resetYearly Boolean @default(false)
}

model DocumentRecord {
  id           Int      @id @default(autoincrement())
  title        String
  category     String
  module       String
  uploadedBy   String   @default("—")
  uploadedDate String   @default("30 Oct 2026")
  expiryDate   String?
  fileSize     String   @default("—")
  fileUrl      String   @default("#")
  createdAt    DateTime @default(now())
}

model InvoiceTemplate {
  id          Int      @id @default(autoincrement())
  name        String
  type        String   @default("sale")
  paper       String   @default("a4")
  orientation String   @default("portrait")
  isDefault   Boolean  @default(false)
  isActive    Boolean  @default(true)
  blocksJson  String   @default("[]")
  createdAt   DateTime @default(now())
}

model MfsService {
  id            Int      @id @default(autoincrement())
  companyId     Int      @default(1)
  company       Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  name          String
  shortName     String?
  accountName   String?
  accountNumber String?
  accountType   String?
  isActive      Boolean  @default(true)
  createdAt     DateTime @default(now())
}

model AuditLog {
  id          Int      @id @default(autoincrement())
  userId      Int?
  user        User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  userName    String   @default("System Administrator")
  ipAddress   String   @default("172.68.163.168")
  event       String   @default("created")
  recordTitle String
  recordType  String
  fieldsCount Int      @default(1)
  fieldsList  String   @default("")
  whenLabel   String   @default("Just now")
  createdAt   DateTime @default(now())
}

model AppSetting {
  id             Int    @id @default(autoincrement())
  appName        String @default("e-Hishabi ERP")
  appTagline     String @default("Real Estate & Development Suite")
  footerText     String @default("")
  contactEmail   String @default("info@ehishabi.com")
  contactPhone   String @default("")
  website        String @default("https://erp.ehishabi.com")
  contactAddress String @default("")
  primaryColor   String @default("#00c292")
}

model Project {
  id                     Int                  @id @default(autoincrement())
  companyId              Int                  @default(1)
  company                Company              @relation(fields: [companyId], references: [id], onDelete: Cascade)
  code                   String               @unique
  name                   String
  projectTypeId          Int?
  projectType            ProjectType?         @relation(fields: [projectTypeId], references: [id], onDelete: SetNull)
  projectCategoryId      Int?
  projectCategory        ProjectCategory?     @relation(fields: [projectCategoryId], references: [id], onDelete: SetNull)
  managerId              Int?
  managerName            String?
  clientName             String?
  priority               String               @default("medium")
  location               String
  city                   String?
  country                String               @default("BD")
  latitude               Float?
  longitude              Float?
  phase                  String
  completionPct          Int                  @default(0)
  progress               Int                  @default(0)
  soldUnits              Int                  @default(0)
  totalUnits             Int                  @default(0)
  startDate              String?
  expectedCompletionDate String?
  actualCompletionDate   String?
  handoverDate           String
  status                 String               @default("planning")
  currency               String               @default("BDT")
  description            String?
  budget                 Float                @default(0)
  estimatedCost          Float                @default(0)
  actualCost             Float                @default(0)
  bookedValueCr          Float                @default(0)
  createdBy              String?
  createdAt              DateTime             @default(now())
  parcels                LandParcel[]
  warehouses             Warehouse[]
  buildings              Building[]
  tasks                  ProjectTask[]
  teams                  ProjectTeam[]
  costs                  ProjectCost[]
  consumptions           ProjectConsumption[]
}

model LandParcel {
  id            Int             @id @default(autoincrement())
  companyId     Int             @default(1)
  company       Company         @relation(fields: [companyId], references: [id], onDelete: Cascade)
  code          String          @unique
  title         String?
  landType      String
  stage         String          @default("prospect")
  mouza         String
  jlNo          String?
  mouzaMapSheet String?
  division      String?
  district      String
  upazila       String?
  unionWard     String?
  policeStation String?
  road          String?
  postalCode    String?
  addressLine   String?
  latitude      Float?
  longitude     Float?
  areaValue     Float
  areaUnit      String
  areaSqft      Float
  boundaryNorth String?
  boundarySouth String?
  boundaryEast  String?
  boundaryWest  String?
  frontageFeet  Float?
  roadWidthFeet Float?
  currentUse    String?
  isCornerPlot  Boolean         @default(false)
  source        String?
  brokerName    String?
  brokerContact String?
  remarks       String?
  bookValue     Float           @default(0)
  projectId     Int?
  project       Project?        @relation(fields: [projectId], references: [id])
  proposals     LandProposal[]
  agreements    LandAgreement[]
  payments      LandPayment[]
  buildings     Building[]
  createdAt     DateTime        @default(now())
  updatedAt     DateTime        @updatedAt
}

model LandOwner {
  id                      Int             @id @default(autoincrement())
  code                    String          @unique
  kind                    String          @default("individual")
  name                    String
  nid                     String?         @unique
  tin                     String?
  fatherName              String?
  motherName              String?
  spouseName              String?
  registrationNumber      String?
  dateOfBirth             String?
  isMinor                 Boolean         @default(false)
  isDeceased              Boolean         @default(false)
  guardianName            String?
  guardianNid             String?
  guardianRelation        String?
  successionCertificateNo String?
  successionDate          String?
  dateOfDeath             String?
  phone                   String?
  alternatePhone          String?
  email                   String?
  addressLine1            String?
  village                 String?
  postOffice              String?
  policeStation           String?
  upazila                 String?
  district                String?
  postalCode              String?
  bankName                String?
  bankBranch              String?
  bankAccountName         String?
  bankAccountNo           String?
  routingNumber           String?
  mfsProvider             String?
  mfsNumber               String?
  notes                   String?
  isActive                Boolean         @default(true)
  createdAt               DateTime        @default(now())
  agreements              LandAgreement[]
  payments                LandPayment[]
}

model LandProposal {
  id           Int        @id @default(autoincrement())
  code         String     @unique
  parcelId     Int
  parcel       LandParcel @relation(fields: [parcelId], references: [id], onDelete: Cascade)
  proposalDate String
  ratePerKatha Float
  totalValue   Float
  status       String     @default("draft")
  remarks      String?
  createdAt    DateTime   @default(now())
}

model LandAgreement {
  id             Int           @id @default(autoincrement())
  code           String        @unique
  parcelId       Int
  parcel         LandParcel    @relation(fields: [parcelId], references: [id], onDelete: Cascade)
  ownerId        Int?
  owner          LandOwner?    @relation(fields: [ownerId], references: [id])
  type           String        @default("sale_agreement")
  status         String        @default("active")
  agreementDate  String
  expiryDate     String?
  agreedPrice    Float
  advanceAmount  Float         @default(0)
  advanceSettled Boolean       @default(false)
  notes          String?
  createdAt      DateTime      @default(now())
  payments       LandPayment[]
}

model LandPayment {
  id                   Int            @id @default(autoincrement())
  voucherNo            String         @unique
  parcelId             Int
  parcel               LandParcel     @relation(fields: [parcelId], references: [id], onDelete: Cascade)
  ownerId              Int?
  owner                LandOwner?     @relation(fields: [ownerId], references: [id])
  agreementId          Int?
  agreement          LandAgreement? @relation(fields: [agreementId], references: [id])
  direction            String         @default("payout")
  type                 String         @default("advance")
  paymentDate          String
  grossAmount          Float
  taxDeducted          Float          @default(0)
  otherDeduction       Float          @default(0)
  netAmount            Float
  method               String         @default("bank_transfer")
  accountName          String?
  bankName             String?
  chequeNo             String?
  chequeDate           String?
  transactionReference String?
  narration            String?
  status               String         @default("posted")
  createdAt            DateTime       @default(now())
}

// ============================================================================
// Tier 1 — Finance Masters (/accounting/*)
// ============================================================================

model ChartAccount {
  id             Int            @id @default(autoincrement())
  companyId      Int            @default(1)
  company        Company        @relation(fields: [companyId], references: [id], onDelete: Cascade)
  parentId       Int?
  parent         ChartAccount?  @relation("AccountTree", fields: [parentId], references: [id], onDelete: SetNull)
  children       ChartAccount[] @relation("AccountTree")
  code           String         @unique
  name           String
  accountType    String
  normalBalance  String         @default("debit")
  openingBalance Float          @default(0)
  currency       String?
  isGroup        Boolean        @default(false)
  isSystem       Boolean        @default(false)
  isActive       Boolean        @default(true)
  description    String?
  createdBy      String?
  createdAt      DateTime       @default(now())
  heads          AccountHead[]
}

model AccountHead {
  id              Int          @id @default(autoincrement())
  companyId       Int          @default(1)
  company         Company      @relation(fields: [companyId], references: [id], onDelete: Cascade)
  type            String
  name            String
  accountId       Int
  account         ChartAccount @relation(fields: [accountId], references: [id], onDelete: Cascade)
  defaultCostCode String?
  description     String?
  entriesCount    Int          @default(0)
  isActive        Boolean      @default(true)
  createdBy       String?
  createdAt       DateTime     @default(now())
}

model BankAccount {
  id            Int      @id @default(autoincrement())
  companyId     Int      @default(1)
  company       Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  name          String
  shortName     String?
  accountName   String?
  accountNumber String?
  branch        String?
  routingNumber String?
  swift         String?
  isActive      Boolean  @default(true)
  createdBy     String?
  createdAt     DateTime @default(now())
  lenders       Lender[]
}

model Lender {
  id            Int          @id @default(autoincrement())
  companyId     Int          @default(1)
  company       Company      @relation(fields: [companyId], references: [id], onDelete: Cascade)
  code          String       @unique
  name          String
  lenderType    String       @default("bank")
  contactPerson String?
  phone         String?
  email         String?
  address       String?
  bankId        Int?
  bank          BankAccount? @relation(fields: [bankId], references: [id], onDelete: SetNull)
  loansCount    Int          @default(0)
  notes         String?
  isActive      Boolean      @default(true)
  createdBy     String?
  createdAt     DateTime     @default(now())
}

// ============================================================================
// Tier 1 — Material / Catalog Masters (/pos/*)
// ============================================================================

model UnitOfMeasure {
  id           Int             @id @default(autoincrement())
  companyId    Int             @default(1)
  company      Company         @relation(fields: [companyId], references: [id], onDelete: Cascade)
  code         String          @unique
  name         String
  isBase       Boolean         @default(true)
  baseUnitId   Int?
  baseUnit     UnitOfMeasure?  @relation("UnitConversion", fields: [baseUnitId], references: [id], onDelete: SetNull)
  derivedUnits UnitOfMeasure[] @relation("UnitConversion")
  factor       Float           @default(1)
  isActive     Boolean         @default(true)
  createdBy    String?
  createdAt    DateTime        @default(now())
  products     Product[]
}

model ProductCategory {
  id          Int               @id @default(autoincrement())
  companyId   Int               @default(1)
  company     Company           @relation(fields: [companyId], references: [id], onDelete: Cascade)
  code        String            @unique
  name        String
  parentId    Int?
  parent      ProductCategory?  @relation("CategoryTree", fields: [parentId], references: [id], onDelete: SetNull)
  children    ProductCategory[] @relation("CategoryTree")
  description String?
  isActive    Boolean           @default(true)
  createdBy   String?
  createdAt   DateTime          @default(now())
  products    Product[]
}

model Warehouse {
  id          Int      @id @default(autoincrement())
  companyId   Int      @default(1)
  company     Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  code        String   @unique
  name        String
  type        String   @default("central")
  branchId    Int?
  branch      Branch?  @relation(fields: [branchId], references: [id], onDelete: SetNull)
  projectId   Int?
  project     Project? @relation(fields: [projectId], references: [id], onDelete: SetNull)
  managerName String?
  address     String?
  isDefault   Boolean  @default(false)
  isActive    Boolean  @default(true)
  createdBy   String?
  createdAt   DateTime @default(now())
}

model Product {
  id            Int              @id @default(autoincrement())
  companyId     Int              @default(1)
  company       Company          @relation(fields: [companyId], references: [id], onDelete: Cascade)
  code          String           @unique
  name          String
  type          String           @default("stockable")
  categoryId    Int?
  category      ProductCategory? @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  baseUomId     Int?
  baseUom       UnitOfMeasure?   @relation(fields: [baseUomId], references: [id], onDelete: SetNull)
  sku           String?
  barcode       String?
  costPrice     Float            @default(0)
  salePrice     Float            @default(0)
  reorderLevel  Float            @default(0)
  onHand        Float            @default(0)
  priceInclusive Boolean         @default(false)
  description   String?
  isSellable    Boolean          @default(true)
  isPurchasable Boolean          @default(true)
  isPinnedPos   Boolean          @default(false)
  isActive      Boolean          @default(true)
  createdBy     String?
  createdAt     DateTime         @default(now())
}

// ---------------------------------------------------------------------------
// Tier 2B — Projects & Buildings
// ---------------------------------------------------------------------------

model ProjectType {
  id                Int                @id @default(autoincrement())
  companyId         Int                @default(1)
  company           Company            @relation(fields: [companyId], references: [id], onDelete: Cascade)
  name              String
  description       String?
  icon              String             @default("fa-solid fa-city")
  pill              String             @default("is-neutral")
  sortOrder         Int                @default(10)
  isActive          Boolean            @default(true)
  isBuiltin         Boolean            @default(false)
  createdBy         String?
  createdAt         DateTime           @default(now())
  categories        ProjectCategory[]
  projects          Project[]
  wbsTemplates      WbsTemplate[]
  cbsTemplates      CbsTemplate[]
  estimateTemplates EstimateTemplate[]
  itpTemplates      ItpTemplate[]
  parameters        ProjectParameter[]
}

model ProjectCategory {
  id                Int                @id @default(autoincrement())
  companyId         Int                @default(1)
  company           Company            @relation(fields: [companyId], references: [id], onDelete: Cascade)
  projectTypeId     Int?
  projectType       ProjectType?       @relation(fields: [projectTypeId], references: [id], onDelete: SetNull)
  name              String
  description       String?
  sortOrder         Int                @default(10)
  isActive          Boolean            @default(true)
  isBuiltin         Boolean            @default(false)
  createdBy         String?
  createdAt         DateTime           @default(now())
  projects          Project[]
  wbsTemplates      WbsTemplate[]
  cbsTemplates      CbsTemplate[]
  estimateTemplates EstimateTemplate[]
  itpTemplates      ItpTemplate[]
  parameters        ProjectParameter[]
}

model Building {
  id                    Int                  @id @default(autoincrement())
  companyId             Int                  @default(1)
  company               Company              @relation(fields: [companyId], references: [id], onDelete: Cascade)
  code                  String               @unique
  name                  String
  buildingType          String               @default("residential")
  status                String               @default("under_construction")
  projectId             Int?
  project               Project?             @relation(fields: [projectId], references: [id], onDelete: SetNull)
  landParcelId          Int?
  landParcel            LandParcel?          @relation(fields: [landParcelId], references: [id], onDelete: SetNull)
  ownerName             String?
  developerName         String?
  description           String?
  isActive              Boolean              @default(true)
  location              String?
  city                  String?
  district              String?
  state                 String?
  postalCode            String?
  country               String?              @default("BD")
  latitude              Float?
  longitude             Float?
  floorsAbove           Int                  @default(0)
  floorsBelow           Int                  @default(0)
  totalUnits            Int                  @default(0)
  landArea              Float?
  builtArea             Float?
  lifts                 Int                  @default(0)
  parkingSpaces         Int                  @default(0)
  hasGenerator          Boolean              @default(false)
  hasSecurity           Boolean              @default(false)
  hasFireSafety         Boolean              @default(false)
  amenities             String?
  constructionStartDate String?
  completionDate        String?
  handoverDate          String?
  occupancyDate         String?
  constructionCost      Float?
  currentValue          Float?
  source                String               @default("Manual")
  createdBy             String?
  createdAt             DateTime             @default(now())
  consumptions          ProjectConsumption[]
}

model ProjectTask {
  id            Int                  @id @default(autoincrement())
  projectId     Int
  project       Project              @relation(fields: [projectId], references: [id], onDelete: Cascade)
  parentId      Int?
  parent        ProjectTask?         @relation("TaskTree", fields: [parentId], references: [id], onDelete: SetNull)
  children      ProjectTask[]        @relation("TaskTree")
  title         String
  category      String?
  status        String               @default("new")
  assigneeNames String?
  startDate     String?
  dueDate       String?
  color         String?
  description   String?
  estimatedCost Float                @default(0)
  createdAt     DateTime             @default(now())
  consumptions  ProjectConsumption[]
}

model ProjectTeam {
  id             Int      @id @default(autoincrement())
  projectId      Int
  project        Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  name           String
  departmentName String?
  leadName       String?
  type           String   @default("site")
  memberNames    String?
  createdAt      DateTime @default(now())
}

model ProjectCost {
  id        Int      @id @default(autoincrement())
  projectId Int
