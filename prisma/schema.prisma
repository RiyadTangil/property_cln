  status       String   @default("open")
  totalAmount  Float    @default(0)
  notes        String?
  createdAt    DateTime @default(now())
}

model PurchaseOrder {
  id          Int            @id @default(autoincrement())
  companyId   Int            @default(1)
  company     Company        @relation(fields: [companyId], references: [id], onDelete: Cascade)
  code        String
  supplierId  Int?
  supplier    Supplier?      @relation(fields: [supplierId], references: [id], onDelete: SetNull)
  projectId   Int?
  warehouseId Int?
  orderDate   String
  totalAmount Float          @default(0)
  paidAmount  Float          @default(0)
  status      String         @default("draft")
  notes       String?
  linesJson   String         @default("[]")
  createdBy   String?
  receipts    GoodsReceipt[]
  createdAt   DateTime       @default(now())
}

model DeliveryOrder {
  id           Int       @id @default(autoincrement())
  companyId    Int       @default(1)
  company      Company   @relation(fields: [companyId], references: [id], onDelete: Cascade)
  code         String
  supplierId   Int?
  supplier     Supplier? @relation(fields: [supplierId], references: [id], onDelete: SetNull)
  doNumber     String?
  brand        String?
  liftingPoint String?
  issueDate    String
  validUntil   String?
  projectId    Int?
  warehouseId  Int?
  status       String    @default("open")
  note         String?
  linesJson    String    @default("[]")
  createdAt    DateTime  @default(now())
}

model GoodsReceipt {
  id              Int                 @id @default(autoincrement())
  companyId       Int                 @default(1)
  company         Company             @relation(fields: [companyId], references: [id], onDelete: Cascade)
  code            String
  purchaseOrderId Int?
  purchaseOrder   PurchaseOrder?      @relation(fields: [purchaseOrderId], references: [id], onDelete: SetNull)
  warehouseId     Int?
  receiptDate     String
  status          String              @default("received")
  notes           String?
  inspections     QualityInspection[]
  createdAt       DateTime            @default(now())
}

model QualityInspection {
  id             Int           @id @default(autoincrement())
  companyId      Int           @default(1)
  company        Company       @relation(fields: [companyId], references: [id], onDelete: Cascade)
  code           String
  goodsReceiptId Int?
  goodsReceipt   GoodsReceipt? @relation(fields: [goodsReceiptId], references: [id], onDelete: SetNull)
  inspectionDate String
  result         String        @default("passed")
  inspectorName  String?
  notes          String?
  createdAt      DateTime      @default(now())
}

model SupplierPayment {
  id          Int       @id @default(autoincrement())
  companyId   Int       @default(1)
  company     Company   @relation(fields: [companyId], references: [id], onDelete: Cascade)
  code        String
  supplierId  Int?
  supplier    Supplier? @relation(fields: [supplierId], references: [id], onDelete: SetNull)
  paymentDate String
  amount      Float     @default(0)
  method      String    @default("bank")
  reference   String?
  accountId   Int?
  narration   String?
  status      String    @default("posted")
  createdAt   DateTime  @default(now())
}

model MaterialIssue {
  id              Int      @id @default(autoincrement())
  companyId       Int      @default(1)
  company         Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  code            String
  warehouseId     Int?
  projectId       Int?
  issueDate       String
  purpose         String?
  responsibleName String?
  status          String   @default("issued")
  totalAmount     Float    @default(0)
  notes           String?
  linesJson       String   @default("[]")
  createdAt       DateTime @default(now())
}

model StockTransfer {
  id              Int      @id @default(autoincrement())
  companyId       Int      @default(1)
  company         Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  code            String
  fromWarehouseId Int?
  toWarehouseId   Int?
  transferDate    String
  reference       String?
  status          String   @default("draft")
  notes           String?
  linesJson       String   @default("[]")
  createdAt       DateTime @default(now())
}

model MaterialConsumption {
  id              Int      @id @default(autoincrement())
  companyId       Int      @default(1)
  company         Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  code            String
  projectId       Int?
  buildingId      Int?
  warehouseId     Int?
  consumptionDate String
  status          String   @default("posted")
  totalCost       Float    @default(0)
  notes           String?
  linesJson       String   @default("[]")
  createdAt       DateTime @default(now())
}

model MaterialRequirement {
  id          Int      @id @default(autoincrement())
  companyId   Int      @default(1)
  company     Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  code        String
  boqId       Int?
  projectId   Int?
  warehouseId Int?
  title       String
  factor      Float    @default(1)
